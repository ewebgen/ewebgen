# Copy this file to .env and fill in your own values. Never commit .env.

# Flask session/signing secret - use a long random string
SECRET_KEY=change-me-to-a-long-random-string

# Database: SQLite is easiest for local testing (no server needed)
EWEBGEN_DB=sqlite
# EWEBGEN_DATA_DIR=./data

# Or MySQL (production)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=ewebgen
# DB_PASS=your-password
# DB_NAME=ewebgen

# Local testing only: skip the commercial license check on http://localhost
FLASK_ENV=development
LICENSE_DEV_BYPASS=1

# First admin login password (you'll be asked to change it on first start)
ADMIN_DEFAULT_PASS=admin123

# AI provider keys and PayPal sandbox credentials are entered in the app
# (Admin CMS), not here. They are stored in the database.
